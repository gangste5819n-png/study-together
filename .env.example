# ==============================================================================
# Study Together — Environment Configuration Template
# Copy this file to .env or set these in your production deployment environment.
# NEVER commit real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=production

# Client origin(s) permitted for CORS and Socket.IO.
# For multiple allowed frontend domains, separate by commas:
# Example: https://studytogether.app,https://www.studytogether.app
CLIENT_URL=https://studytogether.app
CLIENT_ORIGIN=https://studytogether.app

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# In development: mongodb://127.0.0.1:27017/studytogether
# In production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studytogether?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/studytogether?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# High-entropy random string (32+ characters). Generate via: openssl rand -base64 32
JWT_SECRET=your_production_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Production REST API base URL (must include /api prefix)
VITE_API_URL=https://api.studytogether.app/api

# Production Socket.IO backend URL
VITE_SOCKET_URL=https://api.studytogether.app

# ------------------------------------------------------------------------------
# 5. WebRTC TURN Server (Optional / Recommended for Production NAT Traversal)
# ------------------------------------------------------------------------------
# By default, Google public STUN servers are used for direct P2P connections.
# For users behind symmetric NATs / corporate firewalls, configure a TURN server (e.g. Coturn, Twilio, Metered).
VITE_TURN_SERVER_URL=turn:turn.example.com:3478
VITE_TURN_USERNAME=turn_username
VITE_TURN_CREDENTIAL=turn_credential
